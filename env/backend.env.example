NODE_ENV=development

DATABASE_URL="postgresql://postgres:password@localhost:5432/order_system"
JWT_SECRET=your-random-secret-here
BASE_DOMAIN=localhost

# optional (defaults shown)
PORT=3000
# 旧 JWT_EXPIRES_IN からリネーム。既存の .env を使っている場合はこのキー名に置き換えること
ACCESS_TOKEN_EXPIRES_IN=15m
# リフレッシュトークン再利用検知の猶予期間（秒）。並行リクエストによる誤検知を防ぐための運用値
REFRESH_TOKEN_REUSE_GRACE_SECONDS=8
