{
  "name": "@order-system/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e ../env/backend.env -- prisma generate",
    "db:migrate": "dotenv -e ../env/backend.env -- prisma migrate dev",
    "db:push": "dotenv -e ../env/backend.env -- prisma db push",
    "db:studio": "dotenv -e ../env/backend.env -- prisma studio",
    "db:seed": "dotenv -e ../env/backend.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@order-system/shared": "workspace:*",
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.0.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.17.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3"
  }
}
